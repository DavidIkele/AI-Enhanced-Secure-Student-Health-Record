# ---------------------------------------------------------------------------
# APPLICATION ENVIRONMENT CONFIGURATION (EXAMPLE / TEMPLATE)
# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust values for YOUR local environment.
# NEVER commit real credentials. Use placeholders or development-only values.
# Production must use strong, non-default credentials obtained from secrets
# management, not hard-coded values.

# --- Application ---
APP_NAME="AI-Enhanced Secure Web-Based Student Health Record Management System"
# Use "development" locally; MUST be "production" for live deployments.
APP_ENV=production
# MUST be false in production. When false, generic error pages are shown and
# stack traces / internal paths are never exposed to the browser.
APP_DEBUG=false
# Base URL of the public/ document root (e.g. https://example.com).
# Leave empty to auto-detect from SERVER_NAME/HTTPS (production only).
APP_URL=""

# --- Session ---
SESSION_NAME=srms_session
SESSION_LIFETIME=0
# Idle session timeout in minutes (0 disables).
SESSION_TIMEOUT=30

# --- Database (production-ready placeholders) ---
# Create a dedicated database user with least-privilege permissions:
#   CREATE USER 'srms_user'@'%' IDENTIFIED BY 'Str0ngP@ssw0rd!2026';
#   GRANT SELECT, INSERT, UPDATE, DELETE ON student_health.* TO 'srms_user'@'%';
#   ALTER USER 'srms_user'@'%' WITH max_queries_per_hour 0 MAX_CONNECTIONS_PER_HOUR 0;
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=student_health
# Replace with the dedicated non-root user; never use 'root' in production.
DB_USERNAME=srms_user
# Replace with the password set above; never leave empty in production.
DB_PASSWORD=Str0ngP@ssw0rd!2026
DB_CHARSET=utf8mb4

# --- Cookie / security behaviour ---
# "auto" = use Secure flag only when the request is served over HTTPS.
COOKIE_SECURE=auto
RATE_LIMIT_ATTEMPTS=5
RATE_LIMIT_WINDOW=300
LOCKOUT_HOURS=1

# --- AI decision-support service ---
# Set AI_ENABLED=true and provide a strong, non-default AI_API_KEY in real
# deployments (e.g. >= 32 random bytes from a secrets manager). The FastAPI
# service must be started with the SAME key. Only loopback hosts are allowed
# by default (SSRF guard). AI_ENABLED=false keeps the app fully usable when
# the service is unavailable (every AI call degrades gracefully).
# > Generate a production key: php -r "print bin2hex(random_bytes(32));"
AI_ENABLED=false
AI_BASE_URL=http://127.0.0.1:8000
# Replace with your production AI service API key (32+ random bytes).
# Never commit the placeholder value to version control.
AI_API_KEY=change-me-ai-service-key
AI_ALLOWED_HOSTS=127.0.0.1,localhost,::1
AI_CONNECT_TIMEOUT=3
AI_TIMEOUT=8
AI_RETRIES=1
AI_MAX_REQUEST_BYTES=8192