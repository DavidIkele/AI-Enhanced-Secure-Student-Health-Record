# Copy to .env (do NOT commit real values; never commit the API key).
# The shared API key must be a long random string generated at deploy time,
# e.g.  `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
AI_API_KEY=
APP_ENV=production
APP_DEBUG=false

# Loopback-only binding (never change AI_HOST to a public interface).
AI_HOST=127.0.0.1
AI_PORT=8000

# Paths. Defaults resolve relative to the ai-service directory.
AI_MODEL_STORE=./models
AI_LOG_DIR=./logs
AI_MAX_BODY_BYTES=65536