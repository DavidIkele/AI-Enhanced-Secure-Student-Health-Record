{
    "name": "davidanayo/student-health-record-system",
    "description": "AI-Enhanced Secure Web-Based Student Health Record Management System",
    "type": "project",
    "license": "MIT",
    "keywords": [
        "student health",
        "health record",
        "ai decision support",
        "php",
        "mysql"
    ],
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "php tests/router_smoke.php",
        "test:router": "php tests/router_smoke.php",
        "test:security": "php tests/system/security.php",
        "test:functional": "php tests/system/functional_write.php",
        "test:ai-e2e": "php tests/system/ai_e2e.php",
        "test:ai-unit": "cd ai-service && pytest",
        "test:all": [
            "@test:router",
            "@test:security",
            "@test:functional",
            "@test:ai-unit"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "support": {
        "source": "https://github.com/"
    }
}